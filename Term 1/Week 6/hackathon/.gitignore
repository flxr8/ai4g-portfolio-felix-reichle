# Secrets
.env

# Local environment and model caches (models are ~1.5 GB, re-downloadable)
.venv/
.hf-cache/
hf-cache/

# The live database lives on the `bahn-puls-data` branch (see the workflow).
# Local copies are working files; the final DB is added explicitly
# (git add -f data/pulse.db) for the submission.
data/*.db
data/*.db-journal
data/*.download
STATUS.md

# SentiWS lexicon is CC BY-NC-SA; downloaded on demand, not redistributed
eval/sentiws/

# Raw inputs from other collectors (merged into pulse.db with `pulse.merge`).
# The log is UTF-16 PowerShell output with a local user path; the CSV is an
# exact copy of the partner DB.
data/*.log
data/*.csv
